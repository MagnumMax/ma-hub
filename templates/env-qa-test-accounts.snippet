# Snippet: QA test accounts (/MA-deploy Phase 7, /MA-revise-project)
# Paste into each product .env.example. Emails — канон хаба. Пароли в .env.example пустые.
# Полные значения (с паролем) агент пишет только в .env.local — эталон в
# templates/release-must-work-paths.md (блок «Канон входа»).
# Never commit .env.local. Never print passwords in chat/reports.

# Standard roles (all products) — emails identical everywhere
QA_MANAGER_EMAIL=QA_MANAGER_EMAIL@TEST.COM
QA_MANAGER_PASSWORD=
QA_CLIENT_EMAIL=QA_CLIENT_EMAIL@TEST.COM
QA_CLIENT_PASSWORD=

# Extra product roles, if any: QA_<ROLE>_EMAIL / QA_<ROLE>_PASSWORD
# Example: role "fleet-admin" → QA_FLEET_ADMIN_EMAIL / QA_FLEET_ADMIN_PASSWORD
